# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# "ollama" = free local model for development/testing (install Ollama, then
#            `ollama pull qwen2.5:3b`); OPENAI_API_KEY is not needed.
# "openai" = the paid hosted model (production).
LLM_PROVIDER=ollama

# --- Local model (used when LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
# Retries when a local model's reply fails schema validation
LLM_STRUCTURED_OUTPUT_RETRIES=2

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini
# Shared by both providers
OPENAI_TEMPERATURE=0.0

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (frontend) ---
# Comma-separated list of origins the browser-based frontend is served
# from. The Next.js dev server default is included below.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Phase 9) ---
# postgresql+psycopg://user:password@localhost:5432/ai_data_analyst in production.
# Left empty in local/dev/test runs -- the app falls back to file-based
# storage (Phase 1-8) and an in-memory LangGraph checkpointer.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Redis (Phase 9): caching, rate limiting, Celery broker/backend, SSE pub/sub ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Rate limiting (Phase 9): "<count>/<window>", window one of second|minute|hour ---
ANALYSIS_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=20/minute

# --- Background jobs (Phase 9) ---
ANALYSIS_TIMEOUT_SECONDS=120
JOB_MAX_RETRIES=3

# --- Request validation (Phase 9) ---
MAX_QUESTION_LENGTH=5000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Datasets (Phase 2) ---
MAX_FILE_SIZE_MB=50
DATASET_STORAGE_PATH=./storage/datasets
DATASET_PREVIEW_ROWS=5

# --- DuckDB query engine (Phase 3) ---
DUCKDB_PATH=./storage/duckdb/analytics.duckdb
MAX_QUERY_ROWS=1000
MAX_QUERY_EXECUTION_SECONDS=10

# --- SQL workflow (Phase 6) ---
MAX_SQL_RETRIES=3

# --- Multi-step analysis (Phase 7) ---
MAX_ANALYSIS_STEPS=5

# --- Multi-agent + human-in-the-loop (Phase 8) ---
MAX_REVIEW_RETRIES=2
HUMAN_APPROVAL_CONFIDENCE_THRESHOLD=0.70
HUMAN_APPROVAL_COST_THRESHOLD_MS=2000

# --- Autonomous deep analysis (Phase 10) ---
MAX_HYPOTHESES=5
MAX_INSIGHTS=6
MAX_DEEP_ANALYSIS_REVIEW_RETRIES=2
MAX_DEEP_ANALYSIS_STEPS=12
MAX_DEEP_ANALYSIS_LLM_CALLS=10
MAX_DEEP_ANALYSIS_QUERY_EXECUTIONS=25
MAX_DEEP_ANALYSIS_SECONDS=180

# --- Production deployment (docker-compose.prod.yml only) ---
# Strong random password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me
# Public hostname for the API; Caddy gets an HTTPS certificate for it.
# No domain? Use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
API_DOMAIN=api.example.com
